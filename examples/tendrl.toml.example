# Tendrl Configuration Example
# Copy this file to tendrl.toml and customize for your needs

# ==============================================================================
# USER CONFIGURATION
# ==============================================================================
# Your Nostr identity and default relay preferences

[user]
# Optional: Your npub (for future features like personalized feeds)
npub = "npub1abc123..."

# Optional: Your display name
name = "Your Name"

# Default relays used by all feeds (unless feed specifies custom relays)
relays = [
    "wss://relay.damus.io",
    "wss://nos.lol",
    "wss://relay.nostr.band",
    "wss://theforest.nostr1.com"
]

# Cache behavior
[user.cache]
profile_ttl = 0            # Never expire profiles (0 = infinite)
event_refresh = 300        # Refetch event stats every 5 minutes

# ==============================================================================
# FEED 1: ZAPS
# ==============================================================================
# Lightning payment activity across the network
# Kind 9735 = zap receipts (proof of payment)

[feed.zaps]
name = "Zaps"
description = "Lightning flowing through the network - value transfer made visible"

# Use default user.relays
relay_mode = "general"

# Stream new zaps continuously
fetch_strategy = "stream"

# Show all zaps (not just from people you follow)
filter_by_follows = false

# Always refetch zap stats
refetch_engagement = true

# Display kind 9735 as root items
display_kinds = [9735]

# Fetching pattern (hybrid = local queries + remote filters)
[feed.zaps.pattern]
filter_type = "hybrid"

# Query nostrdb for cached events
local_queries = [
    { kinds = [9735], limit = 500, note = "Zap receipts" },
    { kinds = [0], limit = 500, note = "User profiles" },
]

# Fetch from relays
remote_filters = [
    { kinds = [9735, 0], limit = 250 }
]

# Root event configuration
[feed.zaps.root]
kind = 9735
template = "zap-card"

# Dependency: Sender profile (extracted from zap request description)
[feed.zaps.root.deps.sender]
kind = 0
relation = "sender"
required = true

# Dependency: Recipient profile (from p-tag)
[feed.zaps.root.deps.recipient]
kind = 0
relation = "author"
required = true

# Dependency: Event being zapped (optional, from e-tag)
[feed.zaps.root.deps.target_event]
relation = "e_tag"
required = false
fetch_any_kind = true

# ==============================================================================
# FEED 2: HIGHLIGHTS
# ==============================================================================
# Annotated text excerpts from articles, notes, and other content
# Kind 9802 = highlight events (NIP-84)

[feed.highlights]
name = "Highlights"
description = "Annotated excerpts - text that migrates between contexts"

relay_mode = "general"
fetch_strategy = "stream"
filter_by_follows = false

display_kinds = [9802]

[feed.highlights.pattern]
filter_type = "hybrid"

local_queries = [
    { kinds = [9802], limit = 500, note = "Highlight events" },
    { kinds = [0], limit = 500, note = "User profiles" },
]

remote_filters = [
    { kinds = [9802, 0], limit = 250 }
]

[feed.highlights.root]
kind = 9802
template = "highlight-card"

# Author of the highlight
[feed.highlights.root.deps.author]
kind = 0
relation = "author"
required = true

# The event being highlighted (article, note, etc.)
[feed.highlights.root.deps.highlighted_event]
relation = "e_tag"
required = false
fetch_any_kind = true

# Author of the highlighted content
[feed.highlights.root.deps.highlighted_author]
kind = 0
relation = "highlighted_author"
required = false

# Engagement stats on the highlight itself
[feed.highlights.root.deps.reactions]
kind = 7
relation = "e_tag"
mode = "aggregate"
stats = ["count", "by_content"]

[feed.highlights.root.deps.replies]
kind = 1
relation = "e_tag"
mode = "aggregate"
stats = ["count"]

[feed.highlights.root.deps.zaps]
kind = 9735
relation = "e_tag"
mode = "aggregate"
stats = ["count", "total_sats"]

# ==============================================================================
# FEED 3: LONG-FORM ARTICLES
# ==============================================================================
# Long-form content (blog posts, essays, tutorials)
# Kind 30023 = long-form article (NIP-23)

[feed.articles]
name = "Articles"
description = "Long-form content from across the network"

# Use custom relays optimized for long-form content
relay_mode = "custom"
relays = [
    "wss://theforest.nostr1.com",
    "wss://thecitadel.nostr1.com",
    "wss://relay.nostr.band"
]

# Manual fetch (long-form is more static, not real-time)
fetch_strategy = "manual"
filter_by_follows = false
refetch_engagement = true

display_kinds = [30023]

[feed.articles.pattern]
filter_type = "hybrid"

local_queries = [
    { kinds = [30023], limit = 500, note = "Long-form articles" },
    { kinds = [0], limit = 500, note = "Author profiles" },
]

remote_filters = [
    { kinds = [30023, 0], limit = 250 }
]

[feed.articles.root]
kind = 30023
template = "article-card"

# Author profile
[feed.articles.root.deps.author]
kind = 0
relation = "author"
required = true

# Engagement stats (use a_tag for addressable events!)
[feed.articles.root.deps.reactions]
kind = 7
relation = "a_tag"
mode = "aggregate"
stats = ["count", "by_content"]

[feed.articles.root.deps.zaps]
kind = 9735
relation = "a_tag"
mode = "aggregate"
stats = ["count", "total_sats"]

[feed.articles.root.deps.replies]
kind = 1
relation = "a_tag"
mode = "aggregate"
stats = ["count"]

# ==============================================================================
# FEED 4: NOTES (OPTIONAL - BASIC TIMELINE)
# ==============================================================================
# Short-form text notes (Twitter-like posts)
# Kind 1 = text note

[feed.notes]
name = "Notes"
description = "Short-form text notes from the network"

relay_mode = "general"
fetch_strategy = "stream"

# Set to true to only see notes from people you follow
filter_by_follows = false

display_kinds = [1]

[feed.notes.pattern]
filter_type = "hybrid"

local_queries = [
    { kinds = [1], limit = 1000, note = "Text notes" },
    { kinds = [0], limit = 500, note = "Profiles" },
]

# Fetch recent notes (last 24 hours)
remote_filters = [
    {
        kinds = [1, 0],
        limit = 500,
        # since = 1234567890  # Uncomment and set to (current_time - 86400)
    }
]

[feed.notes.root]
kind = 1
template = "note-card"

# Author profile
[feed.notes.root.deps.author]
kind = 0
relation = "author"
required = true

# Quoted events (from e-tags)
[feed.notes.root.deps.quoted_event]
relation = "e_tag"
required = false
fetch_any_kind = true

# Mentioned profiles (from p-tags)
[feed.notes.root.deps.mentioned_profiles]
kind = 0
relation = "p_tag"
multiple = true
required = false

# Engagement stats
[feed.notes.root.deps.reactions]
kind = 7
relation = "e_tag"
mode = "aggregate"
stats = ["count", "by_content"]

[feed.notes.root.deps.replies]
kind = 1
relation = "e_tag"
mode = "aggregate"
stats = ["count"]

[feed.notes.root.deps.zaps]
kind = 9735
relation = "e_tag"
mode = "aggregate"
stats = ["count", "total_sats"]

[feed.notes.root.deps.reposts]
kind = 6
relation = "e_tag"
mode = "aggregate"
stats = ["count"]

# ==============================================================================
# OPTIONAL FEEDS (uncomment to enable)
# ==============================================================================

